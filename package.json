{
  "name": "zikiboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --port 8787 --local",
    "deploy": "wrangler deploy",
    "types": "wrangler types",
    "check": "wrangler deploy --dry-run",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply zikiboard-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply zikiboard-db --remote"
  },
  "dependencies": {
    "jose": "^5.10.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.2",
    "typescript": "^5.8.3",
    "wrangler": "^4.20.0"
  }
}
