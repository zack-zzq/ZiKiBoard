APP_ORIGIN=http://localhost:8787
CORS_ORIGINS=http://localhost:8787
SESSION_COOKIE_NAME=zikiboard_session
SESSION_TTL_SECONDS=2592000
COOKIE_SAME_SITE=Lax
MAX_IMAGE_BYTES=5242880
ALLOWED_IMAGE_TYPES=image/jpeg,image/png,image/gif,image/webp

# Configure provider metadata here. Cloudflare does not interpolate env vars
# inside AUTH_PROVIDERS, so use clientIdEnv/clientSecretEnv to name the env keys.
# AUTH_PROVIDERS=[{"id":"github","name":"GitHub","type":"github","clientIdEnv":"GITHUB_CLIENT_ID","clientSecretEnv":"GITHUB_CLIENT_SECRET"},{"id":"google","name":"Google","type":"oidc","issuer":"https://accounts.google.com","clientIdEnv":"GOOGLE_CLIENT_ID","clientSecretEnv":"GOOGLE_CLIENT_SECRET"},{"id":"microsoft","name":"Microsoft","type":"oidc","issuer":"https://login.microsoftonline.com/common/v2.0","clientIdEnv":"MICROSOFT_CLIENT_ID","clientSecretEnv":"MICROSOFT_CLIENT_SECRET"},{"id":"dingtalk","name":"DingTalk","type":"oidc","issuer":"https://your-dingtalk-issuer","clientIdEnv":"DINGTALK_CLIENT_ID","clientSecretEnv":"DINGTALK_CLIENT_SECRET"}]
AUTH_PROVIDERS=[]

# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# DINGTALK_CLIENT_ID=
# DINGTALK_CLIENT_SECRET=
